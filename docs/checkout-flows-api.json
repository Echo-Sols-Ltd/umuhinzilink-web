{
  "title": "Umuhinzilink Checkout Flows & Order Negotiations API",
  "version": "1.0.0",
  "description": "Complete API specification for checkout flows and order negotiations",
  "baseUrl": "/api/v1",
  "cartManagement": {
    "itemTypes": {
      "NORMAL": {
        "description": "Standard purchase items ready for immediate checkout",
        "canCheckout": true,
        "requiresNegotiation": false
      },
      "NEGOTIATION": {
        "description": "Items requiring price negotiation before purchase",
        "canCheckout": false,
        "requiresNegotiation": true,
        "expiresAfter": "3 days"
      },
      "NEGOTIATION_ACCEPTED": {
        "description": "Negotiated items with agreed pricing, ready for checkout",
        "canCheckout": true,
        "requiresNegotiation": false
      }
    },
    "endpoints": {
      "getCart": {
        "method": "GET",
        "path": "/cart",
        "description": "Retrieve the authenticated user's shopping cart with all items",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<CartDTO>"
        }
      },
      "addItem": {
        "method": "POST",
        "path": "/cart/items",
        "description": "Add a product to cart for normal purchase",
        "authRequired": true,
        "request": {
          "type": "AddToCartRequest",
          "fields": {
            "productId": "UUID",
            "quantity": "Integer",
            "unitPrice": "Double"
          }
        },
        "response": {
          "type": "EndPointResponse<CartItemDTO>"
        }
      },
      "addItemForNegotiation": {
        "method": "POST",
        "path": "/cart/items/negotiate",
        "description": "Add a product to cart with price negotiation request",
        "authRequired": true,
        "request": {
          "type": "AddToCartRequest",
          "fields": {
            "productId": "UUID",
            "quantity": "Integer",
            "proposedPrice": "Double",
            "type": "CartItemType.NEGOTIATION"
          }
        },
        "response": {
          "type": "EndPointResponse<CartItemDTO>"
        }
      },
      "updateCartItem": {
        "method": "PUT",
        "path": "/cart/items/{itemId}",
        "description": "Update the quantity of an item in the cart",
        "authRequired": true,
        "params": {
          "itemId": "UUID"
        },
        "request": {
          "type": "UpdateCartItemRequest",
          "fields": {
            "quantity": "Integer"
          }
        },
        "response": {
          "type": "EndPointResponse<CartItemDTO>"
        }
      },
      "removeCartItem": {
        "method": "DELETE",
        "path": "/cart/items/{itemId}",
        "description": "Remove a specific item from the cart",
        "authRequired": true,
        "params": {
          "itemId": "UUID"
        },
        "response": {
          "type": "EndPointResponse<Void>"
        }
      },
      "clearCart": {
        "method": "DELETE",
        "path": "/cart",
        "description": "Remove all items from the cart",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<Void>"
        }
      },
      "getReadyForCheckoutItems": {
        "method": "GET",
        "path": "/cart/items/ready-for-checkout",
        "description": "Get all cart items that are ready for checkout",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<List<CartItemDTO>>"
        }
      },
      "getNormalItems": {
        "method": "GET",
        "path": "/cart/items/normal",
        "description": "Get all normal (non-negotiation) items in cart",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<List<CartItemDTO>>"
        }
      },
      "getAcceptedNegotiationItems": {
        "method": "GET",
        "path": "/cart/items/accepted-negotiations",
        "description": "Get all items with accepted negotiations",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<List<CartItemDTO>>"
        }
      },
      "cleanupExpiredNegotiations": {
        "method": "POST",
        "path": "/cart/cleanup-expired",
        "description": "Remove expired negotiation items from cart",
        "authRequired": true,
        "response": {
          "type": "EndPointResponse<Void>"
        }
      }
    }
  },
  "checkoutFlows": {
    "normalCheckout": {
      "method": "POST",
      "path": "/cart/checkout/normal",
      "description": "Create orders for all normal (non-negotiation) items in cart",
      "authRequired": true,
      "request": {
        "type": "CheckoutRequest",
        "fields": {
          "paymentMethod": "PaymentMethod"
        }
      },
      "response": {
        "type": "EndPointResponse<List<OrderDTO>>"
      },
      "process": [
        "Validates cart has normal items",
        "Creates orders with original product prices",
        "Removes checked-out items from cart",
        "Creates new cart if all items processed"
      ]
    },
    "negotiatedCheckout": {
      "method": "POST",
      "path": "/cart/checkout/negotiated",
      "description": "Create orders for all items with accepted negotiations",
      "authRequired": true,
      "request": {
        "type": "CheckoutRequest",
        "fields": {
          "paymentMethod": "PaymentMethod"
        }
      },
      "response": {
        "type": "EndPointResponse<List<OrderDTO>>"
      },
      "process": [
        "Validates cart has accepted negotiation items",
        "Creates orders with negotiated prices",
        "Removes checked-out items from cart"
      ]
    },
    "mixedCheckout": {
      "method": "POST",
      "path": "/cart/checkout/mixed",
      "description": "Create orders for both normal items and accepted negotiations",
      "authRequired": true,
      "request": {
        "type": "CheckoutRequest",
        "fields": {
          "paymentMethod": "PaymentMethod"
        }
      },
      "response": {
        "type": "EndPointResponse<List<OrderDTO>>"
      },
      "process": [
        "Combines normal and accepted negotiation items",
        "Processes all items in single transaction",
        "Returns consolidated order list"
      ]
    },
    "createNegotiations": {
      "method": "POST",
      "path": "/cart/negotiate",
      "description": "Create negotiation requests for all negotiation items in cart",
      "authRequired": true,
      "request": {
        "type": "CheckoutRequest",
        "fields": {
          "paymentMethod": "PaymentMethod"
        }
      },
      "response": {
        "type": "EndPointResponse<List<CartItemDTO>>"
      },
      "process": [
        "Creates orders with OrderType.NEGOTIATED",
        "Sets 3-day expiration for negotiations",
        "Updates cart items with negotiation IDs"
      ]
    }
  },
  "orderNegotiation": {
    "statuses": {
      "PENDING": {
        "description": "Initial proposal awaiting seller response",
        "canAccept": true,
        "canReject": true,
        "canCounter": true
      },
      "COUNTERED": {
        "description": "Seller made counter-offer, buyer decision needed",
        "canAccept": true,
        "canReject": true,
        "canCounter": false
      },
      "ACCEPTED": {
        "description": "Agreement reached, converts to normal order",
        "canAccept": false,
        "canReject": false,
        "canCounter": false,
        "final": true
      },
      "REJECTED": {
        "description": "Negotiation declined by seller",
        "canAccept": false,
        "canReject": false,
        "canCounter": false,
        "final": true
      },
      "EXPIRED": {
        "description": "3-day timeout reached",
        "canAccept": false,
        "canReject": false,
        "canCounter": false,
        "final": true
      }
    },
    "endpoints": {
      "getNegotiation": {
        "method": "GET",
        "path": "/orders/{id}/negotiation",
        "description": "Retrieve negotiation details for a specific order",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<NegotiationDTO>"
        }
      },
      "acceptNegotiation": {
        "method": "PUT",
        "path": "/orders/{id}/negotiation/accept",
        "description": "Seller accepts the negotiation and converts to confirmed order",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<NegotiationDTO>"
        },
        "effects": [
          "Converts negotiation to confirmed order",
          "Updates order status to PROCESSING",
          "Updates cart item to NEGOTIATION_ACCEPTED"
        ]
      },
      "rejectNegotiation": {
        "method": "PUT",
        "path": "/orders/{id}/negotiation/reject",
        "description": "Seller rejects the negotiation",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "request": {
          "type": "String",
          "description": "Optional rejection message"
        },
        "response": {
          "type": "EndPointResponse<NegotiationDTO>"
        },
        "effects": [
          "Cancels the negotiation",
          "Sets order status to CANCELLED",
          "Removes item from cart"
        ]
      },
      "counterOffer": {
        "method": "PUT",
        "path": "/orders/{id}/negotiation/counter",
        "description": "Seller makes a counter offer",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "request": {
          "type": "CounterOfferRequest",
          "fields": {
            "counterPrice": "Double",
            "message": "String"
          }
        },
        "response": {
          "type": "EndPointResponse<NegotiationDTO>"
        },
        "effects": [
          "Proposes new price (50%-150% of original)",
          "Extends negotiation expiration by 3 days",
          "Updates negotiation status to COUNTERED"
        ]
      },
      "getBuyerNegotiations": {
        "method": "GET",
        "path": "/orders/negotiations/buyer",
        "description": "Get all negotiations for authenticated buyer",
        "authRequired": true,
        "response": {
          "type": "PageResponse<NegotiationDTO>"
        }
      },
      "getSellerNegotiations": {
        "method": "GET",
        "path": "/orders/negotiations/seller",
        "description": "Get all negotiations for authenticated seller",
        "authRequired": true,
        "response": {
          "type": "PageResponse<NegotiationDTO>"
        }
      }
    },
    "websockets": {
      "messageEndpoint": {
        "path": "/app/negotiation/{negotiationId}/message",
        "description": "Real-time chat between buyer and seller",
        "request": {
          "type": "NegotiationMessage",
          "fields": {
            "type": "String (CHAT, OFFER, COUNTER_OFFER)",
            "content": "String",
            "proposedPrice": "Double",
            "timestamp": "Long"
          }
        },
        "broadcasts": [
          "/topic/negotiation/{negotiationId}",
          "/queue/negotiationMessage (to both parties)"
        ]
      },
      "statusEndpoint": {
        "path": "/app/negotiation/{negotiationId}/status",
        "description": "Real-time negotiation status changes",
        "request": {
          "type": "NegotiationStatusUpdate",
          "fields": {
            "action": "String (ACCEPT, REJECT, COUNTER)",
            "message": "String",
            "counterPrice": "Double"
          }
        },
        "broadcasts": [
          "/topic/negotiation/{negotiationId}",
          "/queue/negotiationAccepted",
          "/queue/negotiationRejected"
        ]
      }
    }
  },
  "orderManagement": {
    "types": {
      "NORMAL": "Standard purchase order",
      "NEGOTIATED": "Order created for negotiation purposes"
    },
    "endpoints": {
      "createOrder": {
        "method": "POST",
        "path": "/orders",
        "description": "Create new order",
        "authRequired": true,
        "request": {
          "type": "OrderRequest",
          "fields": {
            "productId": "String",
            "quantity": "Integer",
            "totalPrice": "Double",
            "orderType": "OrderType",
            "paymentMethod": "PaymentMethod"
          }
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      },
      "getBuyerOrders": {
        "method": "GET",
        "path": "/orders/buyer",
        "description": "Get buyer's orders with pagination",
        "authRequired": true,
        "params": {
          "page": "Integer (default: 0)",
          "size": "Integer (default: 10)"
        },
        "response": {
          "type": "PageResponse<OrderDTO>"
        }
      },
      "getSellerOrders": {
        "method": "GET",
        "path": "/orders/seller",
        "description": "Get seller's orders with pagination",
        "authRequired": true,
        "params": {
          "page": "Integer (default: 0)",
          "size": "Integer (default: 10)"
        },
        "response": {
          "type": "PageResponse<OrderDTO>"
        }
      },
      "getOrderById": {
        "method": "GET",
        "path": "/orders/{id}",
        "description": "Get specific order by ID",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      },
      "acceptOrder": {
        "method": "PUT",
        "path": "/orders/{id}/accept",
        "description": "Seller accepts order",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      },
      "rejectOrder": {
        "method": "PUT",
        "path": "/orders/{id}/reject",
        "description": "Seller rejects order",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      },
      "updateOrderStatus": {
        "method": "PUT",
        "path": "/orders/{id}/status",
        "description": "Update order delivery status",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "request": {
          "type": "DeliveryStatus"
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      },
      "markOrderSatisfied": {
        "method": "POST",
        "path": "/orders/{id}/satisfaction",
        "description": "Buyer confirms that order was delivered safely",
        "authRequired": true,
        "params": {
          "id": "UUID"
        },
        "response": {
          "type": "EndPointResponse<OrderDTO>"
        }
      }
    }
  },
  "businessRules": {
    "priceValidation": {
      "negotiationRange": "50%-150% of original price",
      "counterOfferRange": "50%-150% of original price",
      "description": "Prevents unrealistic pricing"
    },
    "timeLimits": {
      "negotiationExpiration": "3 days",
      "counterOfferExtension": "3 days",
      "automaticCleanup": "Hourly expiration checks"
    },
    "cartManagement": {
      "oneActiveCartPerUser": true,
      "automaticRecreation": "After full checkout",
      "expiredItemRemoval": "Automatic"
    }
  },
  "dataModels": {
    "CartDTO": {
      "id": "UUID",
      "status": "CartStatus",
      "items": "List<CartItemDTO>",
      "totalValue": "Double",
      "totalItems": "Integer",
      "createdAt": "LocalDateTime",
      "updatedAt": "LocalDateTime"
    },
    "CartItemDTO": {
      "id": "UUID",
      "product": "ProductDTO",
      "quantity": "Integer",
      "unitPrice": "Double",
      "type": "CartItemType",
      "proposedPrice": "Double",
      "negotiationId": "UUID",
      "negotiationExpiresAt": "LocalDateTime",
      "totalPrice": "Double",
      "readyForCheckout": "Boolean",
      "expired": "Boolean",
      "createdAt": "LocalDateTime",
      "updatedAt": "LocalDateTime"
    },
    "OrderDTO": {
      "id": "UUID",
      "buyer": "UserDTO",
      "product": "ProductDTO",
      "quantity": "Integer",
      "totalPrice": "Double",
      "isPaid": "Boolean",
      "status": "OrderStatus",
      "paymentMethod": "PaymentMethod",
      "isBuyerSatisfied": "Boolean",
      "orderType": "OrderType",
      "negotiation": "NegotiationDTO",
      "delivery": "DeliveryDTO",
      "createdAt": "LocalDateTime",
      "updatedAt": "LocalDateTime"
    },
    "NegotiationDTO": {
      "id": "UUID",
      "order": "OrderDTO",
      "buyerProposedPrice": "Double",
      "sellerResponsePrice": "Double",
      "lastMessage": "String",
      "status": "NegotiationStatus",
      "expiresAt": "LocalDateTime",
      "expired": "Boolean",
      "timeRemaining": "String",
      "canBuyerRespond": "Boolean",
      "canSellerRespond": "Boolean",
      "createdAt": "LocalDateTime",
      "updatedAt": "LocalDateTime"
    },
    "CheckoutRequest": {
      "paymentMethod": "PaymentMethod"
    },
    "AddToCartRequest": {
      "productId": "UUID",
      "quantity": "Integer",
      "unitPrice": "Double",
      "proposedPrice": "Double",
      "type": "CartItemType"
    },
    "UpdateCartItemRequest": {
      "quantity": "Integer"
    },
    "CounterOfferRequest": {
      "counterPrice": "Double",
      "message": "String"
    },
    "NegotiationMessage": {
      "type": "String",
      "content": "String",
      "proposedPrice": "Double",
      "timestamp": "Long"
    },
    "NegotiationStatusUpdate": {
      "action": "String",
      "message": "String",
      "counterPrice": "Double"
    }
  },
  "enums": {
    "CartItemType": ["NORMAL", "NEGOTIATION", "NEGOTIATION_ACCEPTED"],
    "CartStatus": ["ACTIVE", "CHECKED_OUT"],
    "OrderType": ["NORMAL", "NEGOTIATED"],
    "OrderStatus": ["PROCESSING", "CANCELLED", "DELIVERED", "SATISFIED"],
    "NegotiationStatus": ["PENDING", "COUNTERED", "ACCEPTED", "REJECTED", "EXPIRED"],
    "PaymentMethod": ["WALLET", "MOBILE_MONEY", "BANK_TRANSFER", "CASH_ON_DELIVERY"],
    "DeliveryStatus": ["PENDING", "IN_TRANSIT", "DELIVERED", "CANCELLED"]
  },
  "responseFormat": {
    "EndPointResponse": {
      "data": "T",
      "message": "String",
      "success": "Boolean"
    },
    "PageResponse": {
      "content": "List<T>",
      "page": "Integer",
      "size": "Integer",
      "totalElements": "Long",
      "totalPages": "Integer",
      "first": "Boolean",
      "last": "Boolean"
    }
  },
  "errorHandling": {
    "exceptions": {
      "OrderException": "Order-related errors",
      "ValidationException": "Price limit validation errors",
      "AuthorizationException": "User permission errors",
      "EntityNotFoundException": "Resource not found errors"
    },
    "commonErrors": {
      "INVALID_PRICE_RANGE": "Proposed price must be between 50% and 150% of original price",
      "ACTIVE_NEGOTIATION_EXISTS": "You already have an active negotiation for this product",
      "CART_EMPTY": "No items available for checkout",
      "NEGOTIATION_NOT_ACTIVE": "Negotiation is no longer active",
      "UNAUTHORIZED_ACTION": "Only the product owner can perform this action"
    }
  },
  "automatedProcesses": {
    "scheduledTasks": {
      "expirationCheck": {
        "frequency": "Every hour",
        "action": "Auto-expire negotiations older than 3 days",
        "effects": [
          "Sets negotiation status to EXPIRED",
          "Cancels associated orders",
          "Removes items from cart"
        ]
      },
      "cartCleanup": {
        "frequency": "Daily",
        "action": "Remove expired negotiation items from cart",
        "effects": ["Updates cart status", "Notifies users"]
      }
    }
  }
}
