{
  "summary": {
    "title": "Umuhinzilink Checkout & Negotiation System",
    "description": "Complete overview of checkout flows and order negotiation processes",
    "version": "1.0.0"
  },
  "checkoutFlows": [
    {
      "name": "Normal Checkout",
      "endpoint": "POST /api/v1/cart/checkout/normal",
      "description": "Process standard cart items without negotiation",
      "prerequisites": ["Cart contains NORMAL items"],
      "process": [
        "Validate cart items",
        "Create orders at original prices",
        "Remove items from cart",
        "Create new cart if empty"
      ],
      "outcome": "List of OrderDTO objects"
    },
    {
      "name": "Negotiated Checkout",
      "endpoint": "POST /api/v1/cart/checkout/negotiated",
      "description": "Process items with accepted price negotiations",
      "prerequisites": ["Cart contains NEGOTIATION_ACCEPTED items"],
      "process": [
        "Validate accepted negotiations",
        "Create orders at negotiated prices",
        "Remove items from cart"
      ],
      "outcome": "List of OrderDTO objects"
    },
    {
      "name": "Mixed Checkout",
      "endpoint": "POST /api/v1/cart/checkout/mixed",
      "description": "Process both normal and negotiated items together",
      "prerequisites": ["Cart contains NORMAL and/or NEGOTIATION_ACCEPTED items"],
      "process": [
        "Combine all eligible items",
        "Process in single transaction",
        "Return consolidated order list"
      ],
      "outcome": "List of all OrderDTO objects"
    },
    {
      "name": "Create Negotiations",
      "endpoint": "POST /api/v1/cart/negotiate",
      "description": "Initiate price negotiations for cart items",
      "prerequisites": ["Cart contains NEGOTIATION items"],
      "process": [
        "Create NEGOTIATED type orders",
        "Set 3-day expiration",
        "Link cart items to negotiations"
      ],
      "outcome": "Updated CartItemDTO objects with negotiation IDs"
    }
  ],
  "negotiationFlow": {
    "stages": [
      {
        "stage": "Initiation",
        "description": "Buyer requests price negotiation",
        "actions": [
          "Add item to cart as NEGOTIATION type",
          "Create NEGOTIATED order",
          "Set 3-day expiration"
        ],
        "participants": ["Buyer"]
      },
      {
        "stage": "Active Negotiation",
        "description": "Price discussion and counter-offers",
        "actions": [
          "Real-time chat via WebSocket",
          "Price proposals (50%-150% range)",
          "Counter-offers extend deadline"
        ],
        "participants": ["Buyer", "Seller"],
        "duration": "3 days (extendable)"
      },
      {
        "stage": "Resolution",
        "description": "Final agreement or rejection",
        "actions": [
          "ACCEPT: Convert to normal order",
          "REJECT: Cancel order and remove from cart",
          "EXPIRE: Auto-cancel after timeout"
        ],
        "participants": ["Seller (accept/reject)", "System (expire)"]
      }
    ],
    "statusTransitions": {
      "PENDING": ["ACCEPTED", "REJECTED", "COUNTERED", "EXPIRED"],
      "COUNTERED": ["ACCEPTED", "REJECTED", "EXPIRED"],
      "ACCEPTED": [],
      "REJECTED": [],
      "EXPIRED": []
    }
  },
  "cartItemLifecycle": {
    "NORMAL": {
      "initial": "Add to cart",
      "checkout": "Direct checkout available",
      "negotiation": "Not applicable"
    },
    "NEGOTIATION": {
      "initial": "Add to cart for negotiation",
      "checkout": "Not available until accepted",
      "negotiation": "Creates NEGOTIATED order, 3-day expiry"
    },
    "NEGOTIATION_ACCEPTED": {
      "initial": "Negotiation accepted",
      "checkout": "Available with negotiated price",
      "negotiation": "Complete"
    }
  },
  "keyEndpoints": {
    "cart": [
      "GET /api/v1/cart",
      "POST /api/v1/cart/items",
      "POST /api/v1/cart/items/negotiate",
      "PUT /api/v1/cart/items/{itemId}",
      "DELETE /api/v1/cart/items/{itemId}",
      "DELETE /api/v1/cart"
    ],
    "checkout": [
      "POST /api/v1/cart/checkout/normal",
      "POST /api/v1/cart/checkout/negotiated",
      "POST /api/v1/cart/checkout/mixed",
      "POST /api/v1/cart/negotiate"
    ],
    "negotiation": [
      "GET /api/v1/orders/{id}/negotiation",
      "PUT /api/v1/orders/{id}/negotiation/accept",
      "PUT /api/v1/orders/{id}/negotiation/reject",
      "PUT /api/v1/orders/{id}/negotiation/counter",
      "GET /api/v1/orders/negotiations/buyer",
      "GET /api/v1/orders/negotiations/seller"
    ],
    "orders": [
      "POST /api/v1/orders",
      "GET /api/v1/orders/buyer",
      "GET /api/v1/orders/seller",
      "GET /api/v1/orders/{id}",
      "PUT /api/v1/orders/{id}/accept",
      "PUT /api/v1/orders/{id}/reject",
      "PUT /api/v1/orders/{id}/status",
      "POST /api/v1/orders/{id}/satisfaction"
    ]
  },
  "businessRules": {
    "pricing": {
      "negotiationRange": "50%-150% of original price",
      "validation": "Both proposals and counter-offers"
    },
    "timing": {
      "negotiationDuration": "3 days",
      "counterOfferExtension": "Additional 3 days",
      "expirationCheck": "Hourly automated cleanup"
    },
    "cart": {
      "maxActiveCarts": "1 per user",
      "autoRecreation": "After full checkout",
      "expiredItemRemoval": "Automatic"
    }
  },
  "websockets": {
    "negotiationChat": {
      "endpoint": "/app/negotiation/{negotiationId}/message",
      "description": "Real-time communication during negotiations",
      "participants": ["Buyer", "Seller"]
    },
    "statusUpdates": {
      "endpoint": "/app/negotiation/{negotiationId}/status",
      "description": "Real-time negotiation status changes",
      "actions": ["ACCEPT", "REJECT", "COUNTER"]
    }
  },
  "dataFlow": [
    "1. Cart Addition → Item added with type (NORMAL/NEGOTIATION)",
    "2. Checkout Selection → Choose appropriate checkout method",
    "3. Order Creation → Orders generated based on cart item types",
    "4. Negotiation (if applicable) → Real-time price negotiation",
    "5. Payment Processing → Handle payment through selected method",
    "6. Order Fulfillment → Delivery tracking and satisfaction confirmation"
  ]
}
